<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sandbox stays on so the Developer ID build and the later Mac App Store build share one codebase
	     (documents/DIRECTION.md, decisions on 2026-10-11). Reading the clipboard works inside the sandbox.
	     Revisit this if Cmd+V interception (an event tap) is added. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
